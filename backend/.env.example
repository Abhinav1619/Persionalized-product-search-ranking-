# Application
APP_NAME=RankWise AI
DEBUG=true
DATABASE_URL=sqlite:///./rankwise.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Semantic encoder (CPU-friendly default)
# Options: sentence-transformers/all-MiniLM-L6-v2 (default),
#          huawei-noah/TinyBERT_General_4L_312D,
#          thenlper/gte-small
SEMANTIC_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_DEVICE=cpu
ENABLE_SEMANTIC_MODEL=true

# Ranking fallback weights (used when trained MMoE weights are absent)
RANK_W_SEMANTIC=0.45
RANK_W_STRUCTURED=0.25
RANK_W_PERSONALIZATION=0.30

# Optional path to trained MMoE checkpoint (.pt). Leave empty for demo ranker.
MMOE_CHECKPOINT_PATH=

# Logging
LOG_LEVEL=INFO